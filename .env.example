# Provider, model and endpoint configuration for the harness.
# Flags on the command line always win; these are the defaults.

# ollama | openai | openrouter
HARNESS_PROVIDER=ollama

HARNESS_MODEL=qwen3.8-coder:latest

# ollama: http://127.0.0.1:11434
# openai: https://api.openai.com/v1   (or any OpenAI-compatible server)
# openrouter: https://openrouter.ai/api/v1
HARNESS_BASE_URL=http://127.0.0.1:11434

# Model-service key for openai / openrouter. The provider-specific vars
# (OPENAI_API_KEY, OPENROUTER_API_KEY) are also honored.
# HARNESS_API_KEY=sk-...

# Legacy names still honored for the ollama provider:
#   OLLAMA_MODEL, OLLAMA_HOST