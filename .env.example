# Provider, model and endpoint configuration for the harness.
# Flags on the command line win; then these env defaults.

# The default provider is ollama, configured below. Any other provider is
# selected explicitly with --provider (built-in or a providers.yaml entry).

# Preferred way to configure extra providers: a YAML file of named providers.
# See README ("Provider config file"). It is read only when --provider is used.
# Locations: --config PATH, $HARNESS_CONFIG, ./providers.yaml,
# ~/.config/harness/providers.yaml, %APPDATA%/harness/providers.yaml.
# HARNESS_CONFIG=/path/to/providers.yaml

# --- ollama (default provider) ---
HARNESS_MODEL=qwen3.8-coder:latest
HARNESS_BASE_URL=http://127.0.0.1:11434

# --- model-service key for openai / openrouter ---
# The provider-specific vars (OPENAI_API_KEY, OPENROUTER_API_KEY) are honored
# too; HARNESS_API_KEY works for any provider.
# HARNESS_API_KEY=sk-...

# Legacy names still honored for the ollama provider:
#   OLLAMA_MODEL, OLLAMA_HOST